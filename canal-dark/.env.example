# Copie este arquivo para .env e preencha com suas chaves reais.
# NUNCA commite o arquivo .env (ele já está no .gitignore).

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# https://console.cloud.google.com/apis/credentials (ative a "YouTube Data API v3")
# Usado apenas como proxy de tendência (o TikTok não tem API pública de trends).
YOUTUBE_API_KEY=

# Região usada para buscar os vídeos em alta (código ISO 3166-1 alpha-2)
YOUTUBE_REGION_CODE=BR

# Termos de busca do nicho (separados por vírgula) usados para encontrar
# vídeos em alta sobre nutrição/dieta/emagrecimento/receitas
NICHO_TERMOS_BUSCA=receita fit,dieta cetogênica,emagrecimento,receita saudável,nutrição,low carb,perder peso rápido,jejum intermitente,dieta para emagrecer,receita de dieta

# Quantos vídeos buscar por termo (antes de deduplicar e ordenar por views)
YOUTUBE_RESULTADOS_POR_TERMO=5

# Só considera vídeos publicados nos últimos N dias (evita conteúdo antigo)
YOUTUBE_DIAS_RECENCIA=30

# Quantidade máxima de ideias mantidas em data/ideias.csv por execução
YOUTUBE_MAX_RESULTS=25

# https://elevenlabs.io/app/settings/api-keys (usado por gerar_voz.py)
ELEVENLABS_API_KEY=

# ID da voz da ElevenLabs a usar (padrão: "Rachel", voz multilíngue). Troque
# por uma voz brasileira específica da sua conta, se preferir.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
